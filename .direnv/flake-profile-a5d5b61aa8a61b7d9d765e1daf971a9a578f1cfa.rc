declare -a pkgsTargetTarget=('/nix/store/6zdgga8jx741p46wmx8xyibwz3x3fps6-ncurses-6.5' '/nix/store/i6a553gjc2i4r4p54qk5mdy3ybsiydwk-libffi-3.5.1' '/nix/store/hnzqas16kwcvaj2j5wb4izxdh692f9vn-elfutils-0.193' '/nix/store/12m0v9p2c5pshd8m201z8la0ijd95ri9-gmp-with-cxx-6.3.0' '/nix/store/z6bn6ri10cax3lnyc4hx628hgdvaxgf1-numactl-2.0.18' )
declare -a postFixupHooks=('noBrokenSymlinksInAllOutputs' '_makeSymlinksRelativeInAllOutputs' '_multioutPropagateDev' )
