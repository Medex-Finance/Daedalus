cabal-version:       2.4
name:                orchestrator-backend
version:             0.1.0.0
synopsis:            AI-driven project manager backend
license:             MIT
license-file:        LICENSE
author:              AI Assistant
maintainer:          you@example.com
build-type:          Simple
extra-source-files:  README.md

library orchestrator-types
  exposed-modules:
      App.Types
  hs-source-dirs:   types
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:
      base >=4.14 && <4.20
    , aeson >=2.1
    , aeson-typescript >=0.6
    , elm-bridge
    , persistent
    , persistent-template
    , template-haskell
    , text
    , time

library
  exposed-modules:
      App.Foundation
    , App.Application
    , App.Models
    , App.Evidence
    , App.Settings
    , App.PromptStore
    , App.Orchestrator
    , App.AgentGateway
    , App.Worktree
    , App.Preview
    , App.StatusStream
    , App.ProcessDispatcher
    , App.Direnv
    , App.API
    , App.Queue
    , App.Logging
    , App.Migrations
    , App.Gemini
    , App.RepoProfiles
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:
      base >=4.14 && <4.20
    , orchestrator-types
    , aeson >=2.1
    , aeson-typescript >=0.6
    , aeson-pretty
    , async
    , base64-bytestring
    , bytestring
    , conduit
    , JuicyPixels
    , containers
    , directory
    , filepath
    , process
    , http-conduit
    , http-client
    , http-client-tls
    , http-types
    , mime-types
    , monad-logger
    , persistent
    , persistent-sqlite
    , persistent-template
    , text
    , time
    , transformers
    , typed-process
    , unordered-containers
    , vector
    , stm
    , unliftio
    , unliftio-core
    , yesod
    , yesod-core
    , yesod-form
    , yesod-static
    , wai
    , wai-extra
    , warp

executable backend
  main-is:           Main.hs
  hs-source-dirs:    app
  ghc-options:       -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base
    , orchestrator-backend
    , orchestrator-types
    , yesod
    , warp
  default-language:  Haskell2010

executable generate-types
  main-is:           GenerateTypes.hs
  hs-source-dirs:    app
  ghc-options:       -Wall
  build-depends:
      base
    , orchestrator-types
    , aeson-typescript
    , elm-bridge
    , text
  default-language:  Haskell2010

executable seed
  main-is:           Seed.hs
  hs-source-dirs:    app
  ghc-options:       -Wall
  build-depends:
      base
    , orchestrator-backend
    , orchestrator-types
    , persistent
    , persistent-sqlite
    , text
    , time
  default-language:  Haskell2010

test-suite integration
  type:              exitcode-stdio-1.0
  hs-source-dirs:    test
  main-is:           Spec.hs
  other-modules:     OrchestratorSpec
                   , EvidenceSpec
  default-language:  Haskell2010
  ghc-options:       -Wall
  build-depends:
      base
    , orchestrator-backend
    , orchestrator-types
    , aeson
    , aeson-pretty
    , bytestring
    , containers
    , directory
    , filepath
    , hspec
    , monad-logger
    , persistent
    , persistent-sqlite
    , process
    , stm
    , text
    , time
    , temporary
    , yesod-static
